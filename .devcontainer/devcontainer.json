{
  "name": "Linux GUI (LXQt)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "version": "latest"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Linux Desktop",
      "onAutoForward": "openBrowser"
    }
  }
}
