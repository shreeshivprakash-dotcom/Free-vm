{
  "name": "Persistent Ubuntu Desktop",
  "image": "://microsoft.com",
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "version": "latest"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup-persistence.sh",
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Ubuntu Desktop GUI",
      "onAutoForward": "openBrowser"
    }
  }
}
